{
  "name": "@comenta/feedback",
  "version": "0.1.0",
  "description": "Embeddable element-commenting widget (comment mode)",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/types/react/index.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    },
    "./github": {
      "types": "./dist/types/github/index.d.ts",
      "import": "./dist/github.js",
      "require": "./dist/github.cjs"
    },
    "./settings": {
      "types": "./dist/types/settings/index.d.ts",
      "import": "./dist/settings.js",
      "require": "./dist/settings.cjs"
    },
    "./iife": "./dist/feedback.iife.js",
    "./settings-iife": "./dist/settings.iife.js"
  },
  "sideEffects": false,
  "scripts": {
    "build": "vite build && vite build --config vite.iife.config.ts && vite build --config vite.settings.config.ts && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "pnpm build && playwright test",
    "demo": "pnpm build && node demo/server.mjs",
    "demo:github": "pnpm build && GITHUB_MOCK=1 node demo/server.mjs",
    "github-app:setup": "node demo/github-app-setup.mjs",
    "size": "node scripts/size.mjs",
    "standalone": "pnpm build && node scripts/standalone.mjs"
  },
  "peerDependencies": {
    "react": ">=17"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
